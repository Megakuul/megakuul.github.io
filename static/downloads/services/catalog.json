{
  "common": [
    {
      "name": "TAG_KEY",
      "example": "Project",
      "required": false,
      "type": "string",
      "hint": "",
      "default": "Project"
    },
    {
      "name": "TAG_VALUE",
      "example": "my-app",
      "required": false,
      "type": "string",
      "hint": "",
      "default": "quickstart"
    },
    {
      "name": "TAGS_JSON",
      "example": "{\"Environment\":\"test\",\"Owner\":\"me\"}",
      "required": false,
      "type": "map",
      "hint": "",
      "default": "{}"
    }
  ],
  "services": [
    {
      "id": "lambda",
      "title": "Lambda \u00b7 ZIP \u00b7 logs \u00b7 recursion protection",
      "env": [
        {
          "name": "NAME",
          "example": "my-function",
          "required": true,
          "type": "string",
          "hint": "",
          "pattern": "[A-Za-z0-9][A-Za-z0-9_.-]{0,63}"
        },
        {
          "name": "ROLE_NAME",
          "example": "my-app-role",
          "required": true,
          "type": "string",
          "hint": "Existing execution role; paste the required service permissions into its bound policy.",
          "pattern": "[A-Za-z0-9+=,.@_-]{1,64}"
        }
      ],
      "defaults": {
        "LOG_GROUP": "",
        "LOG_RETENTION_DAYS": 30,
        "RUNTIME": "nodejs24.x",
        "HANDLER": "index.handler",
        "ARCHITECTURE": "arm64",
        "MEMORY_MB": 256,
        "TIMEOUT_SECONDS": 10,
        "EPHEMERAL_MB": 512,
        "RESERVED_CONCURRENCY": 5,
        "ZIP_FILE": "",
        "LAMBDA_ENV_JSON": {},
        "SUBNET_IDS": "",
        "SECURITY_GROUP_IDS": "",
        "DLQ_ARN": "",
        "KMS_KEY_ARN": ""
      }
    },
    {
      "id": "s3",
      "title": "S3 \u00b7 private \u00b7 versioned \u00b7 access logs \u00b7 lifecycle",
      "env": [
        {
          "name": "NAME",
          "example": "my-app-bucket-111122223333",
          "required": true,
          "type": "string",
          "hint": "",
          "pattern": "[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]"
        }
      ],
      "defaults": {
        "ACCESS_LOG_BUCKET": "",
        "ACCESS_LOG_RETENTION_DAYS": 90,
        "NONCURRENT_RETENTION_DAYS": 90,
        "MULTIPART_ABORT_DAYS": 7,
        "KMS_KEY_ARN": ""
      }
    },
    {
      "id": "sqs",
      "title": "SQS \u00b7 encrypted \u00b7 long polling \u00b7 scoped DLQ",
      "env": [
        {
          "name": "NAME",
          "example": "my-queue",
          "required": true,
          "type": "string",
          "hint": "Add .fifo to NAME for a FIFO queue; a matching DLQ is created automatically.",
          "pattern": "[A-Za-z0-9_-]{1,70}(?:\\.fifo)?"
        }
      ],
      "defaults": {
        "QUEUE_TYPE": "standard",
        "DLQ_NAME": "",
        "QUEUE_RETENTION_DAYS": 4,
        "DLQ_RETENTION_DAYS": 14,
        "VISIBILITY_SECONDS": 180,
        "MAX_RECEIVE_COUNT": 5,
        "WAIT_SECONDS": 20
      }
    },
    {
      "id": "sns",
      "title": "SNS \u00b7 encrypted topic \u00b7 HTTPS only",
      "env": [
        {
          "name": "NAME",
          "example": "my-topic",
          "required": true,
          "type": "string",
          "hint": "",
          "pattern": "[A-Za-z0-9][A-Za-z0-9_.-]{0,63}"
        }
      ],
      "defaults": {
        "KMS_KEY_ID": "alias/aws/sns"
      }
    },
    {
      "id": "eventbridge",
      "title": "EventBridge \u00b7 private custom event bus",
      "env": [
        {
          "name": "NAME",
          "example": "my-event-bus",
          "required": true,
          "type": "string",
          "hint": "",
          "pattern": "[A-Za-z0-9][A-Za-z0-9_.-]{0,63}"
        }
      ],
      "defaults": {
        "KMS_KEY_ARN": ""
      }
    },
    {
      "id": "ecr",
      "title": "ECR \u00b7 immutable tags \u00b7 scanning \u00b7 untagged cleanup",
      "env": [
        {
          "name": "NAME",
          "example": "my-app/backend",
          "required": true,
          "type": "string",
          "hint": "",
          "pattern": "[a-z0-9]+(?:[._/-][a-z0-9]+)*"
        }
      ],
      "defaults": {
        "UNTAGGED_RETENTION_DAYS": 30,
        "KMS_KEY_ARN": ""
      }
    },
    {
      "id": "ecs",
      "title": "ECS \u00b7 empty cluster \u00b7 enhanced Container Insights \u00b7 exec logs",
      "env": [
        {
          "name": "NAME",
          "example": "my-cluster",
          "required": true,
          "type": "string",
          "hint": "",
          "pattern": "[A-Za-z0-9][A-Za-z0-9_.-]{0,63}"
        }
      ],
      "defaults": {
        "LOG_GROUP": "",
        "LOG_RETENTION_DAYS": 30,
        "KMS_KEY_ARN": ""
      }
    },
    {
      "id": "logs",
      "title": "CloudWatch Logs \u00b7 retention + deletion protection",
      "env": [
        {
          "name": "NAME",
          "example": "/app/my-app",
          "required": true,
          "type": "string",
          "hint": "",
          "pattern": "[.\\-_/#A-Za-z0-9]{1,512}"
        }
      ],
      "defaults": {
        "LOG_RETENTION_DAYS": 30,
        "KMS_KEY_ARN": ""
      }
    },
    {
      "id": "secret",
      "title": "Secrets Manager \u00b7 empty encrypted secret",
      "env": [
        {
          "name": "NAME",
          "example": "my-app/database",
          "required": true,
          "type": "string",
          "hint": "",
          "pattern": "[A-Za-z0-9/_+=.@-]{1,512}"
        }
      ],
      "defaults": {
        "KMS_KEY_ARN": ""
      }
    },
    {
      "id": "appconfig",
      "title": "AppConfig \u00b7 hosted JSON \u00b7 staged deployment strategy",
      "env": [
        {
          "name": "NAME",
          "example": "my-app",
          "required": true,
          "type": "string",
          "hint": "",
          "pattern": "[A-Za-z0-9][A-Za-z0-9_.-]{0,63}"
        }
      ],
      "defaults": {
        "APPCONFIG_ENVIRONMENT": "test",
        "CONFIG_PROFILE": "settings",
        "DEPLOYMENT_MINUTES": 10,
        "GROWTH_PERCENT": 20,
        "BAKE_MINUTES": 10
      }
    },
    {
      "id": "states",
      "title": "Step Functions \u00b7 placeholder \u00b7 error logs without payloads",
      "env": [
        {
          "name": "NAME",
          "example": "my-workflow",
          "required": true,
          "type": "string",
          "hint": "",
          "pattern": "[A-Za-z0-9][A-Za-z0-9_.-]{0,63}"
        },
        {
          "name": "ROLE_NAME",
          "example": "my-app-role",
          "required": true,
          "type": "string",
          "hint": "Existing execution role; paste the required service permissions into its bound policy.",
          "pattern": "[A-Za-z0-9+=,.@_-]{1,64}"
        }
      ],
      "defaults": {
        "LOG_GROUP": "",
        "LOG_RETENTION_DAYS": 30,
        "STATE_MACHINE_TYPE": "STANDARD",
        "KMS_KEY_ARN": ""
      }
    },
    {
      "id": "athena",
      "title": "Athena \u00b7 managed encrypted results \u00b7 scan limit",
      "env": [
        {
          "name": "NAME",
          "example": "my-workgroup",
          "required": true,
          "type": "string",
          "hint": "",
          "pattern": "[A-Za-z0-9][A-Za-z0-9_.-]{0,63}"
        }
      ],
      "defaults": {}
    },
    {
      "id": "kinesis",
      "title": "Kinesis \u00b7 on-demand \u00b7 encrypted \u00b7 72-hour retention",
      "env": [
        {
          "name": "NAME",
          "example": "my-stream",
          "required": true,
          "type": "string",
          "hint": "",
          "pattern": "[A-Za-z0-9][A-Za-z0-9_.-]{0,63}"
        }
      ],
      "defaults": {
        "KMS_KEY_ID": "alias/aws/kinesis",
        "STREAM_RETENTION_HOURS": 72
      }
    },
    {
      "id": "security",
      "title": "GuardDuty + IAM Access Analyzer \u00b7 enable \u00b7 account / region",
      "env": [
        {
          "name": "NAME",
          "example": "account-access",
          "required": true,
          "type": "string",
          "pattern": "[A-Za-z][A-Za-z0-9_-]{0,254}",
          "hint": "External-access analyzer name. Reuses an existing account external-access analyzer in REGION, even if named differently."
        }
      ],
      "defaults": {
        "FINDING_FREQUENCY": "FIFTEEN_MINUTES"
      }
    }
  ]
}

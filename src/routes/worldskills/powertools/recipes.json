[
  {
    "id": "efs",
    "title": "EFS",
    "recipes": [
      {
        "id": "efs-reader",
        "title": "Reader",
        "command": "aws iam create-policy --policy-name app-efs-reader --policy-document {{policy}} --query Policy.Arn --output text",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "elasticfilesystem:ClientMount",
              "Resource": "arn:aws:elasticfilesystem:eu-central-1:111122223333:file-system/fs-0123456789abcdef0",
              "Condition": {
                "StringEquals": {
                  "elasticfilesystem:AccessPointArn": "arn:aws:elasticfilesystem:eu-central-1:111122223333:access-point/fsap-0123456789abcdef0"
                },
                "Bool": {
                  "aws:SecureTransport": "true",
                  "elasticfilesystem:AccessedViaMountTarget": "true"
                }
              }
            }
          ]
        }
      },
      {
        "id": "efs-writer",
        "title": "Writer",
        "command": "aws iam create-policy --policy-name app-efs-writer --policy-document {{policy}} --query Policy.Arn --output text",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": ["elasticfilesystem:ClientMount", "elasticfilesystem:ClientWrite"],
              "Resource": "arn:aws:elasticfilesystem:eu-central-1:111122223333:file-system/fs-0123456789abcdef0",
              "Condition": {
                "StringEquals": {
                  "elasticfilesystem:AccessPointArn": "arn:aws:elasticfilesystem:eu-central-1:111122223333:access-point/fsap-0123456789abcdef0"
                },
                "Bool": {
                  "aws:SecureTransport": "true",
                  "elasticfilesystem:AccessedViaMountTarget": "true"
                }
              }
            }
          ]
        }
      }
    ]
  },
  {
    "id": "cloudwatch-logs",
    "title": "CloudWatch Logs",
    "recipes": [
      {
        "id": "cloudwatch-logs-fixed-stream-writer",
        "title": "Fixed stream writer",
        "command": "aws iam create-policy --policy-name app-log-stream-writer --policy-document {{policy}} --query Policy.Arn --output text",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "logs:PutLogEvents",
              "Resource": "arn:aws:logs:eu-central-1:111122223333:log-group:/app/api:log-stream:worker-1"
            }
          ]
        }
      },
      {
        "id": "cloudwatch-logs-dynamic-stream-writer",
        "title": "Dynamic stream writer",
        "command": "aws iam create-policy --policy-name app-log-group-writer --policy-document {{policy}} --query Policy.Arn --output text",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
              "Resource": "arn:aws:logs:eu-central-1:111122223333:log-group:/app/api:log-stream:*"
            }
          ]
        }
      },
      {
        "id": "cloudwatch-logs-vpc-flow-log-writer",
        "title": "VPC flow-log writer",
        "command": "aws iam create-policy --policy-name app-vpc-flow-log-writer --policy-document {{policy}} --query Policy.Arn --output text",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": ["logs:CreateLogGroup", "logs:DescribeLogStreams"],
              "Resource": "arn:aws:logs:eu-central-1:111122223333:log-group:/vpc/flow:*"
            },
            {
              "Effect": "Allow",
              "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
              "Resource": "arn:aws:logs:eu-central-1:111122223333:log-group:/vpc/flow:log-stream:*"
            },
            {
              "Effect": "Allow",
              "Action": "logs:DescribeLogGroups",
              "Resource": "*",
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": "eu-central-1"
                }
              }
            }
          ]
        }
      },
      {
        "id": "cloudwatch-logs-flow-log-trust-bootstrap",
        "title": "Flow-log trust, bootstrap",
        "command": "aws iam create-role --role-name app-vpc-flow-logs --assume-role-policy-document {{policy}}",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "vpc-flow-logs.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": "111122223333"
                },
                "ArnLike": {
                  "aws:SourceArn": "arn:aws:ec2:eu-central-1:111122223333:vpc-flow-log/*"
                }
              }
            }
          ]
        }
      },
      {
        "id": "cloudwatch-logs-attach",
        "title": "Attach",
        "command": "aws iam attach-role-policy --role-name app-vpc-flow-logs --policy-arn arn:aws:iam::111122223333:policy/app-vpc-flow-log-writer"
      },
      {
        "id": "cloudwatch-logs-tighten-after-creation",
        "title": "Tighten after creation",
        "command": "aws iam update-assume-role-policy --role-name app-vpc-flow-logs --policy-document {{policy}}",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "vpc-flow-logs.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": "111122223333"
                },
                "ArnEquals": {
                  "aws:SourceArn": "arn:aws:ec2:eu-central-1:111122223333:vpc-flow-log/fl-0123456789abcdef0"
                }
              }
            }
          ]
        }
      }
    ]
  },
  {
    "id": "s3",
    "title": "S3",
    "recipes": [
      {
        "id": "s3-prefix-reader",
        "title": "Prefix reader",
        "command": "aws iam create-policy --policy-name app-s3-reader --policy-document {{policy}} --query Policy.Arn --output text",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "s3:ListBucket",
              "Resource": "arn:aws:s3:::example-app-data",
              "Condition": {
                "StringLike": {
                  "s3:prefix": "app/*"
                }
              }
            },
            {
              "Effect": "Allow",
              "Action": "s3:GetObject",
              "Resource": "arn:aws:s3:::example-app-data/app/*"
            }
          ]
        }
      },
      {
        "id": "s3-prefix-uploader",
        "title": "Prefix uploader",
        "command": "aws iam create-policy --policy-name app-s3-uploader --policy-document {{policy}} --query Policy.Arn --output text",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": ["s3:PutObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
              "Resource": "arn:aws:s3:::example-app-data/app/*"
            }
          ]
        }
      },
      {
        "id": "s3-sse-kms-reader-add-on",
        "title": "SSE-KMS reader add-on",
        "command": "aws iam create-policy --policy-name app-s3-kms-reader --policy-document {{policy}} --query Policy.Arn --output text",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "kms:Decrypt",
              "Resource": "arn:aws:kms:eu-central-1:111122223333:key/12345678-1234-1234-1234-123456789012",
              "Condition": {
                "StringEquals": {
                  "kms:ViaService": "s3.eu-central-1.amazonaws.com"
                },
                "StringLike": {
                  "kms:EncryptionContext:aws:s3:arn": "arn:aws:s3:::example-app-data/app/*"
                }
              }
            }
          ]
        }
      },
      {
        "id": "s3-sse-kms-uploader-add-on",
        "title": "SSE-KMS uploader add-on",
        "command": "aws iam create-policy --policy-name app-s3-kms-uploader --policy-document {{policy}} --query Policy.Arn --output text",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": ["kms:GenerateDataKey", "kms:Decrypt"],
              "Resource": "arn:aws:kms:eu-central-1:111122223333:key/12345678-1234-1234-1234-123456789012",
              "Condition": {
                "StringEquals": {
                  "kms:ViaService": "s3.eu-central-1.amazonaws.com"
                },
                "StringLike": {
                  "kms:EncryptionContext:aws:s3:arn": "arn:aws:s3:::example-app-data/app/*"
                }
              }
            }
          ]
        }
      }
    ]
  },
  {
    "id": "secrets-and-parameters",
    "title": "Secrets and parameters",
    "recipes": [
      {
        "id": "secrets-and-parameters-secret-reader",
        "title": "Secret reader",
        "command": "aws iam create-policy --policy-name app-secret-reader --policy-document {{policy}} --query Policy.Arn --output text",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "secretsmanager:GetSecretValue",
              "Resource": "arn:aws:secretsmanager:eu-central-1:111122223333:secret:app/database-AbCdEf"
            }
          ]
        }
      },
      {
        "id": "secrets-and-parameters-customer-kms-key-add-on",
        "title": "Customer KMS key add-on",
        "command": "aws iam create-policy --policy-name app-secret-kms-reader --policy-document {{policy}} --query Policy.Arn --output text",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "kms:Decrypt",
              "Resource": "arn:aws:kms:eu-central-1:111122223333:key/12345678-1234-1234-1234-123456789012",
              "Condition": {
                "StringEquals": {
                  "kms:ViaService": "secretsmanager.eu-central-1.amazonaws.com",
                  "kms:EncryptionContext:SecretARN": "arn:aws:secretsmanager:eu-central-1:111122223333:secret:app/database-AbCdEf"
                }
              }
            }
          ]
        }
      },
      {
        "id": "secrets-and-parameters-parameter-reader",
        "title": "Parameter reader",
        "command": "aws iam create-policy --policy-name app-parameter-reader --policy-document {{policy}} --query Policy.Arn --output text",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": ["ssm:GetParameter", "ssm:GetParameters"],
              "Resource": "arn:aws:ssm:eu-central-1:111122223333:parameter/app/database-url"
            }
          ]
        }
      },
      {
        "id": "secrets-and-parameters-securestring-kms-add-on",
        "title": "SecureString KMS add-on",
        "command": "aws iam create-policy --policy-name app-parameter-kms-reader --policy-document {{policy}} --query Policy.Arn --output text",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "kms:Decrypt",
              "Resource": "arn:aws:kms:eu-central-1:111122223333:key/12345678-1234-1234-1234-123456789012",
              "Condition": {
                "StringEquals": {
                  "kms:ViaService": "ssm.eu-central-1.amazonaws.com",
                  "kms:EncryptionContext:PARAMETER_ARN": "arn:aws:ssm:eu-central-1:111122223333:parameter/app/database-url"
                }
              }
            }
          ]
        }
      }
    ]
  },
  {
    "id": "sqs-and-sns",
    "title": "SQS and SNS",
    "recipes": [
      {
        "id": "sqs-and-sns-queue-producer",
        "title": "Queue producer",
        "command": "aws iam create-policy --policy-name app-sqs-producer --policy-document {{policy}} --query Policy.Arn --output text",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "sqs:SendMessage",
              "Resource": "arn:aws:sqs:eu-central-1:111122223333:app-jobs"
            }
          ]
        }
      },
      {
        "id": "sqs-and-sns-queue-consumer",
        "title": "Queue consumer",
        "command": "aws iam create-policy --policy-name app-sqs-consumer --policy-document {{policy}} --query Policy.Arn --output text",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "sqs:ReceiveMessage",
                "sqs:DeleteMessage",
                "sqs:ChangeMessageVisibility",
                "sqs:GetQueueAttributes"
              ],
              "Resource": "arn:aws:sqs:eu-central-1:111122223333:app-jobs"
            }
          ]
        }
      },
      {
        "id": "sqs-and-sns-topic-publisher",
        "title": "Topic publisher",
        "command": "aws iam create-policy --policy-name app-sns-publisher --policy-document {{policy}} --query Policy.Arn --output text",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "sns:Publish",
              "Resource": "arn:aws:sns:eu-central-1:111122223333:app-events"
            }
          ]
        }
      }
    ]
  },
  {
    "id": "dynamodb",
    "title": "DynamoDB",
    "recipes": [
      {
        "id": "dynamodb-table-reader",
        "title": "Table reader",
        "command": "aws iam create-policy --policy-name app-dynamodb-reader --policy-document {{policy}} --query Policy.Arn --output text",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": ["dynamodb:GetItem", "dynamodb:BatchGetItem"],
              "Resource": "arn:aws:dynamodb:eu-central-1:111122223333:table/app-orders"
            },
            {
              "Effect": "Allow",
              "Action": "dynamodb:Query",
              "Resource": [
                "arn:aws:dynamodb:eu-central-1:111122223333:table/app-orders",
                "arn:aws:dynamodb:eu-central-1:111122223333:table/app-orders/index/by-customer"
              ]
            }
          ]
        }
      },
      {
        "id": "dynamodb-item-writer",
        "title": "Item writer",
        "command": "aws iam create-policy --policy-name app-dynamodb-writer --policy-document {{policy}} --query Policy.Arn --output text",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": ["dynamodb:PutItem", "dynamodb:UpdateItem"],
              "Resource": "arn:aws:dynamodb:eu-central-1:111122223333:table/app-orders"
            }
          ]
        }
      }
    ]
  },
  {
    "id": "ecr",
    "title": "ECR",
    "recipes": [
      {
        "id": "ecr-image-puller",
        "title": "Image puller",
        "command": "aws iam create-policy --policy-name app-ecr-puller --policy-document {{policy}} --query Policy.Arn --output text",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "ecr:GetAuthorizationToken",
              "Resource": "*",
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": "eu-central-1"
                }
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "ecr:BatchCheckLayerAvailability",
                "ecr:GetDownloadUrlForLayer",
                "ecr:BatchGetImage"
              ],
              "Resource": "arn:aws:ecr:eu-central-1:111122223333:repository/app"
            }
          ]
        }
      },
      {
        "id": "ecr-image-pusher",
        "title": "Image pusher",
        "command": "aws iam create-policy --policy-name app-ecr-pusher --policy-document {{policy}} --query Policy.Arn --output text",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "ecr:GetAuthorizationToken",
              "Resource": "*",
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": "eu-central-1"
                }
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "ecr:BatchCheckLayerAvailability",
                "ecr:InitiateLayerUpload",
                "ecr:UploadLayerPart",
                "ecr:CompleteLayerUpload",
                "ecr:PutImage",
                "ecr:BatchGetImage"
              ],
              "Resource": "arn:aws:ecr:eu-central-1:111122223333:repository/app"
            }
          ]
        }
      }
    ]
  },
  {
    "id": "invoke-and-pass-roles",
    "title": "Invoke and pass roles",
    "recipes": [
      {
        "id": "invoke-and-pass-roles-lambda-invoker",
        "title": "Lambda invoker",
        "command": "aws iam create-policy --policy-name app-lambda-invoker --policy-document {{policy}} --query Policy.Arn --output text",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "lambda:InvokeFunction",
              "Resource": "arn:aws:lambda:eu-central-1:111122223333:function:app-worker:live"
            }
          ]
        }
      },
      {
        "id": "invoke-and-pass-roles-eventbridge-producer",
        "title": "EventBridge producer",
        "command": "aws iam create-policy --policy-name app-event-producer --policy-document {{policy}} --query Policy.Arn --output text",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "events:PutEvents",
              "Resource": "arn:aws:events:eu-central-1:111122223333:event-bus/app",
              "Condition": {
                "StringEquals": {
                  "events:source": "app.orders",
                  "events:detail-type": "OrderCreated"
                }
              }
            }
          ]
        }
      },
      {
        "id": "invoke-and-pass-roles-pass-one-role-to-ecs-tasks",
        "title": "Pass one role to ECS tasks",
        "command": "aws iam create-policy --policy-name app-pass-ecs-task-role --policy-document {{policy}} --query Policy.Arn --output text",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "iam:PassRole",
              "Resource": "arn:aws:iam::111122223333:role/app-task",
              "Condition": {
                "StringEquals": {
                  "iam:PassedToService": "ecs-tasks.amazonaws.com"
                }
              }
            }
          ]
        }
      }
    ]
  },
  {
    "id": "attach-inspect-revise",
    "title": "Attach, inspect, revise",
    "recipes": [
      {
        "id": "attach-inspect-revise-attach",
        "title": "Attach",
        "command": "aws iam attach-role-policy --role-name app-task --policy-arn arn:aws:iam::111122223333:policy/app-efs-reader"
      },
      {
        "id": "attach-inspect-revise-list-attachments",
        "title": "List attachments",
        "command": "aws iam list-attached-role-policies --role-name app-task"
      },
      {
        "id": "attach-inspect-revise-list-versions",
        "title": "List versions",
        "command": "aws iam list-policy-versions --policy-arn arn:aws:iam::111122223333:policy/app-efs-reader --query 'Versions[].{Version:VersionId,Default:IsDefaultVersion,Created:CreateDate}' --output table"
      },
      {
        "id": "attach-inspect-revise-inspect-json",
        "title": "Inspect JSON",
        "command": "aws iam get-policy-version --policy-arn arn:aws:iam::111122223333:policy/app-efs-reader --version-id v1 --query PolicyVersion.Document --output json"
      },
      {
        "id": "attach-inspect-revise-validate-edited-json",
        "title": "Validate edited JSON",
        "command": "aws accessanalyzer validate-policy --region eu-central-1 --policy-type IDENTITY_POLICY --policy-document file://policy.json --query 'findings[].{Type:findingType,Code:issueCode,Detail:findingDetails}' --output table"
      },
      {
        "id": "attach-inspect-revise-free-a-version-slot-only-when-full",
        "title": "Free a version slot only when full",
        "command": "aws iam delete-policy-version --policy-arn arn:aws:iam::111122223333:policy/app-efs-reader --version-id v2"
      },
      {
        "id": "attach-inspect-revise-revise-in-place",
        "title": "Revise in place",
        "command": "aws iam create-policy-version --policy-arn arn:aws:iam::111122223333:policy/app-efs-reader --policy-document file://policy.json --set-as-default"
      },
      {
        "id": "attach-inspect-revise-rollback",
        "title": "Rollback",
        "command": "aws iam set-default-policy-version --policy-arn arn:aws:iam::111122223333:policy/app-efs-reader --version-id v1"
      },
      {
        "id": "attach-inspect-revise-detach",
        "title": "Detach",
        "command": "aws iam detach-role-policy --role-name app-task --policy-arn arn:aws:iam::111122223333:policy/app-efs-reader"
      }
    ]
  }
]

{
  "QueryLanguage": "JSONPath",
  "StartAt": "Child",
  "States": {
    "Child": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Parameters": {
        "StateMachineArn": "arn:aws:states:eu-central-1:111122223333:stateMachine:child",
        "Input": {
          "order.$": "$.order",
          "AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID.$": "$$.Execution.Id"
        }
      },
      "ResultSelector": {
        "receipt.$": "$.Output"
      },
      "ResultPath": "$.child",
      "Next": "Read"
    },
    "Read": {
      "Type": "Pass",
      "Parameters": {
        "orderId.$": "$.order.id",
        "total.$": "$.child.receipt.total"
      },
      "End": true
    }
  }
}
